{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node scripts/dev-port.mjs",
    "build": "next build",
    "start": "next start",
    "bot": "tsx scripts/bot.ts",
    "bot:watch": "tsx watch scripts/bot.ts",
    "bot:up": "nohup npm run bot:watch > /tmp/lost-bot.log 2>&1 & echo \"бот поднят, лог: npm run bot:log\"",
    "bot:down": "pkill -f \"scripts/bot.ts\" && echo \"бот остановлен\"",
    "bot:log": "tail -f /tmp/lost-bot.log",
    "lint": "eslint",
    "build:standings": "tsx scripts/build-standings-site.ts",
    "db:export": "tsx scripts/export-db.ts",
    "db:import": "tsx scripts/import-db.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/nunito": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-separator": "^1.1.15",
    "@tabler/icons-react": "^3.46.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.28.0",
    "modern-screenshot": "^4.7.0",
    "next": "16.2.11",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "playwright": "^1.62.1",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
