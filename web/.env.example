# Шаблон окружения. Скопировать в web/.env и подставить свои значения:
#   cp .env.example .env
# Сам .env в .gitignore — ключи в репозиторий не попадают.

# Путь к SQLite. Обязательно ОТНОСИТЕЛЬНЫЙ к web/ — абсолютный file:-URL ломает libsql на Windows.
DATABASE_URL="file:./prisma/dev.db"

# OpenAI — генерация картинок в /studio/generate. Без ключа остальное приложение работает.
OPENAI_API_KEY=

# Steam Web API — кнопка «Из Steam» на главной (запасной источник матча, когда лежит OpenDota).
# Бесплатный ключ: https://steamcommunity.com/dev/apikey. Без него работает только «Из OpenDota».
STEAM_API_KEY=

# Кто может встроить приложение в <iframe> — домены основного сайта через пробел.
# Пусто = только собственный домен ('self'); тогда встраивание извне браузер заблокирует.
# Пример: FRAME_ANCESTORS="'self' https://leagueofspirits.ru https://*.leagueofspirits.ru"
FRAME_ANCESTORS=

# Вход в систему — только через Google (кабинет /me). Пароля-админки больше нет: доступ к служебной
# части даёт роль owner/admin (владелец задаётся ниже через OWNER_EMAIL и раздаёт роли остальным).
#
# Вход игроков через Google (/me → «Войти через Google»). Ключи заводятся в Google Cloud Console:
# создать OAuth 2.0 Client ID (тип «Web application»), в Authorized redirect URIs добавить
# <адрес сайта>/api/auth/google/callback (для localhost — http://localhost:3000/api/auth/google/callback).
# Оба пустые = кнопка входа скрыта, остальное приложение работает. GOOGLE_REDIRECT_URI нужен, только
# когда сайт открыт по внешнему адресу (прокси/туннель) и origin запроса не совпадает с ним.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Секрет подписи пользовательской сессии (кука входа игрока). Любая длинная случайная строка.
# Пусто = подпись выводится из GOOGLE_CLIENT_SECRET. Смена значения разлогинивает всех игроков.
# ВАЖНО: при входе по email+паролю (без Google) GOOGLE_CLIENT_SECRET пуст — тогда AUTH_SECRET
# обязателен, иначе сессии не подписываются и вход «не залипает».
AUTH_SECRET=

# Dev-автовход: локально (NODE_ENV != production) сессия сама выдаётся аккаунту с этой почтой, когда
# куки входа нет — чтобы не логиниться заново после каждого перезапуска при проверке админки.
# На production переменная игнорируется. Пусто = обычный вход.
DEV_LOGIN_EMAIL=

# Писем приложение не шлёт: почтовый флоу (подтверждение почты, сброс пароля) убран — см.
# docs/archive/ACCOUNTS-PLAN.md §2.4. Поэтому RESEND_API_KEY / MAIL_FROM / APP_URL больше не нужны; когда флоу
# вернут, файлы восстанавливаются из git и ключи возвращаются сюда же.

# Почта владельца лиги (главный админ). Кто войдёт через Google под этим адресом — получает роль
# owner автоматически и панель «Роли и доступ» (/admin/roles), где раздаёт роли админ/игрок другим.
# Остальные админы входят через Google и пароль им не нужен. Пусто = владельца нет, доступ только
# по паролю (ADMIN_PASSWORD).
OWNER_EMAIL=

# Telegram-бот. TG_BOT_TOKEN — токен от @BotFather, нужен обоим потокам:
#   • квиз заявки команды (npm run bot) — бот ведёт капитана по вопросам, готовая заявка ложится
#     в очередь модерации (source = telegram). Работает long polling'ом, публичный адрес не нужен;
#   • авто-выгрузка инфографики матча (scripts/send-infographic.ts) — ей нужен ещё TG_CHAT_ID
#     (куда слать: свой user id, id канала или группы). Квизу чат не нужен: он отвечает отправителю.
# Токена нет = бот не запускается, а пайплайн инфографики только сохраняет PNG на диск
# (public/uploads/postgame), в телеграм не шлёт.
TG_BOT_TOKEN=
TG_CHAT_ID=

# Адрес сайта — его бот подставляет во все ссылки наружу (вход по коду, сборка состава, карточка
# игрока). Пусто и есть поднятый quick tunnel (скилл `serve`) — берётся его адрес из
# web/.cache/tunnel.url; нет и его — http://localhost:3000, а такую ссылку телеграм показывает
# простым текстом. Сюда пишут адрес боевого сервера, когда он появится: заданный BASE_URL сильнее
# туннеля.
BASE_URL=

# Нодовый флоу бота (BOT-FLOW-PLAN.md): 1 — первый уровень меню ведёт граф из `src/lib/bot-flow`,
# пусто — бот работает старым путём целиком. Переменной, а не константой в коде: бот живёт
# долгоживущим процессом, и «попробовать и вернуть как было» должно стоить перезапуска.
BOT_FLOW=
