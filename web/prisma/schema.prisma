// LOST — операционная система: данные / флоу / треккинг.
// Спека: ../../ARCHITECTURE.md. sqlite не поддерживает enum → строковые поля с комментами.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Турнир — сезон лиги или отдельный кубок. До него дивизион был строкой («Division 1») плюс
/// хардкод-справочник в коде: описание, даты и регламент вешать было некуда, а второй сезон с теми
/// же именами дивизионов слился бы с первым. Теперь турнир — сущность, дивизион — его часть.
/// Разбор решений — ../../TOURNAMENTS-PLAN.md.
model Tournament {
  id          Int       @id @default(autoincrement())
  slug        String    @unique // s2, winter-cup — живёт в URL
  name        String // «LOST Season 2»
  short       String? // «S2» — для навигации, где длинное имя не влезает
  description String? // регламент и описание, длинный текст
  format      String? // «2 дивизиона, группа + плей-офф»
  prize       String?
  logo        String?
  banner      String?
  /// Внешний источник id матчей турнира (Liquipedia/Dotabuff и т.п.): откуда оператор берёт номера
  /// карт для привязки в архиве. Живёт у турнира, а не у встречи — список матчей общий на сезон.
  matchesUrl  String?
  /// league_id тикета лиги в Dota 2 (у каждого дивизиона свой): единственный ключ, по которому
  /// матчи сезона связаны программно. По нему тянется список матчей и проверяется, что
  /// привязываемая карта — из этой лиги, а не опечатка в id (src/lib/league-matches.ts).
  leagueId    Int?
  /// draft (заводят) | registration (приём заявок) | running (идёт) | finished (сыгран).
  /// «Текущий» турнир для публичных витрин — running, иначе последний по startAt (src/lib/tournaments.ts).
  status      String    @default("draft")
  startAt     DateTime?
  endAt       DateTime?
  regOpenAt   DateTime?
  regCloseAt  DateTime?
  createdAt   DateTime  @default(now())

  divisions    Division[]
  applications TeamApplication[]
  points       PointsEntry[]
}

/// Дивизион внутри турнира. `slug` живёт в адресе (/standings/d1) и уникален в пределах турнира —
/// «d1» есть в каждом сезоне, и это разные дивизионы. `name` дублируется в Team.group /
/// Series.division / GroupEntry.division: строки остались как denormalized-зеркало ради полутора
/// десятков выборок, которые фильтруют по имени; единственный, кто их пишет — src/lib/tournaments.ts.
model Division {
  id      Int     @id @default(autoincrement())
  slug    String // d1 | d2
  name    String // «Division 1» — то же значение, что в Team.group
  label   String? // «LOST D1» — подпись вкладки
  short   String? // «D1»
  orderNo Int     @default(0) // порядок вкладок в навигации
  mmrFrom Int? // порог входа, если у дивизиона он есть
  mmrTo   Int?
  /// Вылетают ли последние из группы. В D1 два последних вылетают, в D2 все непопавшие в верхнюю
  /// сетку падают в нижнюю — раньше это правило различалось сравнением имени дивизиона со строкой
  /// «Division 2» (src/lib/qualification.ts), что в новом турнире с другими именами не сработало бы.
  relegation Boolean @default(true)

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId Int

  entries      TournamentEntry[]
  rosterSpots  RosterSpot[]
  series       Series[]
  groupEntries GroupEntry[]
  applications TeamApplication[]

  @@unique([tournamentId, slug])
  @@unique([tournamentId, name])
}

/// Участие команды в дивизионе турнира. Отдельной строкой, а не полем у команды: команда живёт
/// дольше турнира, и с полем переход на следующий сезон стирал бы, где она играла в прошлом.
/// Состав (RosterSpot) при этом остаётся текущим составом команды — сезонные составы это отдельный
/// долг (§9 CLAUDE.md); историю игр он не рвёт, кто играл на карте помнит MatchStat.
model TournamentEntry {
  id         Int      @id @default(autoincrement())
  seed       Int? // посев в жеребьёвке
  group      String? // «A» | «B» — группа, если дивизион делится
  createdAt  DateTime @default(now())

  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  divisionId Int
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId     Int

  @@unique([divisionId, teamId])
}

/// Заявка команды на турнир: состав целиком JSON'ом, `Team`/`Player` из неё создаются только при
/// апруве. Причина ровно та же, что у анкеты игрока (UserAccount.application, ACCOUNTS-PLAN §2.1):
/// публичные витрины читают ростер без фильтров, и залитый сразу кривой файл на дюжину команд
/// немедленно виден на /roster/teams, а откатить его нечем.
model TeamApplication {
  id           Int      @id @default(autoincrement())
  /// import (файл в админке) | web (капитан из кабинета) | telegram (бот) — откуда пришла заявка.
  source       String   @default("import")
  /// Состав целиком, JSON (src/lib/team-application.ts → TeamDraft).
  payload      String
  status       String   @default("pending") // pending | approved | rejected
  notes        String? // причина возврата — её видит подавший
  /// Кто подал (id аккаунта) — заполнено у заявок с сайта, у импорта пусто. Без relation, как
  /// reviewedById: это след «чью заявку показывать в кабинете», а не связь (id на машинах разные).
  submittedById Int?
  /// Чат в Telegram, из которого пришла заявка бота. Единственная надёжная ниточка к подавшему:
  /// аккаунта у бота нет, а телеграм капитана в составе может быть и не указан. По ней бот
  /// показывает статус заявки и уведомляет о решении организатора.
  submittedChatId String?
  submittedAt  DateTime @default(now())
  reviewedAt   DateTime?
  reviewedById Int? // след в истории, без relation — как UserAccount.reviewedById

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId Int
  division     Division?  @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  divisionId   Int? // предложенный дивизион; оператор может переставить перед апрувом
  team         Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId       Int? // проставляется при апруве — по нему видно, что заявка уже заведена
}

model Team {
  id        Int      @id @default(autoincrement())
  slug      String   @unique // ключ импорта и имя файла ассета
  name      String
  tag       String?
  logo      String?
  wordmark  String? // граффити-надпись названия (для анонсов)
  photo     String? // командное фото в рамку
  banner    String? // баннер команды (широкая подложка шапки); путь как у logo
  color     String? // акцент команды, hex
  group     String? // имя дивизиона текущего турнира — зеркало TournamentEntry (src/lib/tournaments.ts)
  /// Убрана из общего пула (архив). null — в пуле; дата — когда убрали. Двухэтапное удаление: первое
  /// удаление лишь ставит эту дату (команда исчезает из таба «Ростер» и из добавления в новые турниры,
  /// но её прошлые таблицы/матчи/серии целы), второе — физически сносит запись. См. src/lib/roster-data.ts.
  archivedAt DateTime?
  createdAt DateTime @default(now())

  roster         RosterSpot[]
  matchesA       Match[]       @relation("TeamA")
  matchesB       Match[]       @relation("TeamB")
  matchesWon     Match[]       @relation("Winner")
  matchesRadiant Match[]       @relation("Radiant")
  groupEntries   GroupEntry[]
  seriesHome     Series[]      @relation("SeriesHome")
  seriesAway     Series[]      @relation("SeriesAway")
  wards          Ward[]
  entries        TournamentEntry[] // в каких дивизионах каких турниров команда играла
  applications   TeamApplication[]
}

model Player {
  id          Int       @id @default(autoincrement())
  slug        String    @unique // ключ импорта и имя файла фото; ставится один раз и НЕ меняется —
                                 // от него зависят файлы картинок (uploads.ts), поэтому ник правится, а slug нет
  nickname    String
  nicknameChangedAt DateTime? // когда игрок сам менял ник — для лимита «раз в сезон»; правка оператором не в счёт
  realName    String?
  accountId   String? // Dota/Steam32 account id (для OpenDota)
  mmr         Int? // из таблицы сезона; у команды не хранится — считается по составу
  /// Ранг (rank_tier OpenDota: десятки — медаль, единицы — звезда; 80 = Immortal). В отличие от
  /// mmr — не со слов игрока, а подтянут по account_id при импорте состава (src/lib/enrich.ts).
  rank        Int?
  /// TP за всё время — кеш суммы начислений (`PointsEntry`, reason="tp"). Истина в реестре:
  /// зачёт сезонный, а это поле кормит витрины, которым нужна одна цифра (см. src/lib/tp.ts).
  tp          Int      @default(0)
  photo       String?
  steamUrl    String? // перекрывает ссылку, выведенную из accountId
  dotabuffUrl String?
  stratzUrl   String?
  telegram    String? // хранится без «@» — собачку рисует UI (см. src/lib/profiles.ts)
  birthday    DateTime? // только дата, время не значимо; нужна для возраста в графике и поздравлений
  city        String? // где живёт — город как в CRM, страна опционально следом
  country     String?
  banner      String? // баннер профиля (широкая подложка шапки); путь как у photo
  interviewUrl String? // ссылка на интервью игрока, если есть
  orderNo     Int? // ручное перекрытие номера в шапке профиля; null — номер по id (он же в адресе)
  achievements String? // достижения внутри и вне лиги — свободный текст, одна строка = одно достижение
  tags        String? // роли в лиге через запятую (player,streamer,caster,partner,organizer) — src/lib/player-tags.ts
  createdAt   DateTime  @default(now())

  spots RosterSpot[]
  stats MatchStat[]

  account UserAccount?  @relation("AccountPlayer") // подтверждённый вход игрока (0..1)
  claims  UserAccount[] @relation("AccountClaim") // заявки на привязку, ждущие подтверждения
  edits   ProfileEditRequest[] // правки анкеты, присланные из бота и ждущие оператора
  proposals MatchRequest[] // предложения времени встречи, отправленные им как капитаном
}

/// Аккаунт игрока: вход по Google. Отдельно от `Player` намеренно — профиль игрока есть у всех в
/// ростере, а аккаунт появляется только у того, кто сам вошёл. Один аккаунт ↔ один профиль.
///
/// Новый игрок при входе заводит профиль и привязывается сразу (`playerId`). Существующий в ростере
/// подаёт заявку (`claimId`) — оператор подтверждает её в админке, и тогда `claimId` переезжает в
/// `playerId`. Две связи, а не одна, чтобы непроверенная заявка не считалась привязкой.
///
/// Войти можно двумя способами, и один аккаунт может держать оба: через Google (`googleSub`) или
/// по email + паролю (`passwordHash`). Ключ аккаунта — `email` (уникален): вошёл через Google той же
/// почтой, что регистрировался паролем, — это тот же аккаунт, к нему прицепляется `googleSub`.
/// Поэтому `googleSub` теперь опционален (у чисто парольного аккаунта его нет).
model UserAccount {
  id        Int      @id @default(autoincrement())
  /// Почта. Необязательна с приходом регистрации через бота: у пришедшего из телеграма её нет и
  /// спрашивать её незачем — вход ему тоже телеграмный. Уникальность остаётся: аккаунт с почтой
  /// по-прежнему один на адрес, а null'ов в sqlite уникальный индекс допускает сколько угодно.
  email     String?  @unique
  googleSub String?  @unique // id google-аккаунта («sub» из id_token); null у аккаунта только с паролем
  // Хеш пароля (scrypt, формат `salt:hash` hex — см. src/lib/password.ts). null = входа по паролю нет,
  // только через Google. Сам пароль в БД не хранится нигде.
  passwordHash String?
  // Подтверждена ли почта. Гейтом входа НЕ является: почтовый флоу убран (писем нет), поэтому
  // true ставит только Google-вход — и значит это честно «почту подтвердил Google».
  emailVerified Boolean @default(false)
  name      String? // имя (из google-профиля или введённое при регистрации) — для списка заявок
  avatar    String? // ссылка на аватар google
  // Роль в системе: player (по умолчанию) | admin | owner. Владелец назначается не здесь, а по
  // OWNER_EMAIL (src/lib/account.ts): совпал email при входе — роль owner, и её нельзя отобрать из UI.
  // admin раздаёт владелец в панели ролей; проверка доступа в proxy читает роль из подписанной куки.
  role      String   @default("player")
  // Гранулярные права админа: ключи через запятую (как Player.tags — sqlite не умеет массивы, а
  // таблица ради десятка флагов избыточна). Канон ключей — src/lib/permissions.ts. У владельца
  // права все и неявно, поле ему не нужно.
  permissions String?

  // Воронка регистрации: draft (вошёл, анкеты нет) | pending (анкета отправлена, ждёт решения) |
  // active (одобрен) | rejected (отказ с причиной, можно поправить анкету и отправить снова).
  // Дефолт именно draft, чтобы новый аккаунт — в том числе заведённый Google-callback'ом — попадал
  // в воронку сам, без «не забыть проставить» в каждом месте создания. Владелец (OWNER_EMAIL) вне
  // воронки: он всегда active, иначе апрувить его было бы некому (src/lib/account.ts).
  status String @default("draft")
  // Анкета-заявка целиком, JSON (src/lib/account.ts). Player из неё создаётся только при апруве:
  // публичные витрины читают Player без фильтров, и заведённый заранее неодобренный сразу попал бы
  // в ростер.
  application      String?
  policyAcceptedAt DateTime? // когда согласился с политикой площадки (/rules)
  submittedAt      DateTime? // когда отправил заявку — по нему порядок очереди модерации
  reviewedAt       DateTime? // когда рассмотрели
  reviewedById     Int? // кто рассмотрел (id аккаунта). Без relation: это след в истории, а не связь
  rejectedReason   String? // причина отказа — человек видит её в кабинете и правит анкету

  /// Telegram-id **пользователя** (`from.id` апдейта, не `chat.id`: в личке они совпадают, но ключ
  /// человека — именно from.id). Второй ключ аккаунта рядом с почтой: по нему бот узнаёт человека
  /// после смены хендла, и по нему же выдаётся вход на сайт.
  tgId       String? @unique
  /// Хендл без «@» — справочно, для очереди модерации. Ключом НЕ является: хендл меняют, и
  /// освободившийся может занять посторонний.
  tgUsername String?
  /// Откуда пришёл: web (сайт) | telegram (бот). Оператору в очереди важно видеть источник —
  /// у телеграмной анкеты нет почты, и пустая колонка иначе выглядит поломкой.
  source     String  @default("web")

  player   Player? @relation("AccountPlayer", fields: [playerId], references: [id], onDelete: SetNull)
  playerId Int?    @unique // подтверждённая привязка; уникальна — один профиль на один аккаунт
  claim    Player? @relation("AccountClaim", fields: [claimId], references: [id], onDelete: SetNull)
  claimId  Int? // заявка на существующего игрока, ждёт подтверждения оператора

  chats    ConversationMember[] // беседы, в которых состоит (личная переписка игроков)
  sent     ChatMessage[] // отправленные сообщения

  createdAt DateTime @default(now())
}

/// Место игрока в составе команды. Роль и капитанство живут здесь, а не у игрока: один человек
/// может быть действующим саппортом в одной команде и заменой в другой — это разные места.
/// Инвариант «нельзя быть действующим (поз. 1–5) в двух командах» проверяется в коде
/// (src/lib/roster-spots.ts): sqlite не умеет частичные уникальные индексы.
model RosterSpot {
  id        Int      @id @default(autoincrement())
  role      String? // carry | mid | offlane | soft-support | hard-support | coach | standin (src/lib/roles.ts)
  isCaptain Boolean  @default(false)
  createdAt DateTime @default(now())

  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   Int
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId Int
  /// Дивизион турнира, к которому относится это место. Появился вместе с турнирами: состав команды
  /// меняется от сезона к сезону, и без него заявка нового сезона затирала бы прошлый. NULL —
  /// состав вне турнира (места, заведённые до модели, и команды, ни в чём не участвующие).
  division   Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  divisionId Int?

  @@unique([teamId, playerId, divisionId]) // дважды в одном составе сезона стоять нельзя
}

/// Одна карта. Внутри серии их до трёх — `seriesId` + `gameNumber` (см. `Series`).
/// `durationSec`/`startedAt` живут здесь, а не в `MatchStat`: это свойство карты, а не игрока,
/// но без него рейтинг урона превращается в рейтинг длинных игр — нормировка идёт отсюда.
model Match {
  id              Int       @id @default(autoincrement())
  openDotaMatchId String?   @unique // строкой: id матчей Dota > 32-bit Int
  scheduledAt     DateTime?
  startedAt       DateTime? // из OpenDota, проставляется при привязке карты
  durationSec     Int? // из OpenDota
  status          String    @default("scheduled") // scheduled | live | finished
  createdAt       DateTime  @default(now())

  // Счёт карты по убийствам и первый пик — для страницы серии. Считать счёт из `MatchStat` нельзя:
  // там только игроки лиги, и карта с чужим стендином показала бы заниженные убийства.
  radiantScore     Int?
  direScore        Int?
  firstPickRadiant Boolean?

  teamA         Team  @relation("TeamA", fields: [teamAId], references: [id])
  teamAId       Int
  teamB         Team  @relation("TeamB", fields: [teamBId], references: [id])
  teamBId       Int
  winner        Team? @relation("Winner", fields: [winnerTeamId], references: [id])
  winnerTeamId  Int?
  radiantTeam   Team? @relation("Radiant", fields: [radiantTeamId], references: [id])
  radiantTeamId Int?

  series     Series? @relation(fields: [seriesId], references: [id])
  seriesId   Int?
  gameNumber Int? // 1..N внутри серии

  stats         MatchStat[]
  pointsEntries PointsEntry[]
  renders       Render[]
  wards         Ward[]

  @@unique([seriesId, gameNumber]) // две «второй карты» в одной серии — ошибка ввода
}

/// Строка команды в таблице групповой стадии — как она напечатана в таблице сезона (вкладка «GS»).
/// Групповая стадия отыграна до начала плей-офф и дальше не меняется, поэтому итоги храним как есть,
/// а не пересчитываем: это снимок результата, а не живая таблица лиги (та считается в standings.ts).
model GroupEntry {
  id       Int    @id @default(autoincrement())
  division String // «Division 1»
  group    String // «A» | «B»
  place    Int
  played   Int
  wins     Int
  losses   Int
  points   Int

  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId Int
  /// Дивизион турнира; строка `division` — зеркало (см. Division).
  divisionRef Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  divisionId  Int?

  @@unique([division, group, teamId])
}

/// Личная встреча (Bo1/Bo3) — единица архива турнира. Раньше была `GroupSeries` и знала только
/// группу и счёт; теперь сюда же ложится плей-офф (`stage`), а карты серии — `Match.seriesId`.
/// Это один контейнер на обе стадии намеренно: сетка группы и рейтинги считаются из одних строк,
/// иначе таблица и архив разъедутся как два источника правды.
///
/// `guessed` = пару определили расчётом, а не прочитали (кросс-таблица сезона не подписана —
/// в шапке логотипы, а не текст) — такие подсвечиваем в UI.
///
/// Уникальность — только для группы: там пара играет ровно раз. В плей-офф `group` = NULL,
/// а в sqlite NULL'ы в индексе не равны друг другу, поэтому одни и те же команды могут
/// встретиться и в верхней сетке, и в гранд-финале. Это не дыра, а нужное поведение.
model Series {
  id        Int       @id @default(autoincrement())
  /// Ключ для адреса `/series/<slug>`: `<хозяева>-vs-<гости>`, при повторной встрече с хвостом.
  /// Нужен потому, что `id` автоинкрементный и после `db:import` меняется — ссылка на встречу,
  /// отданная наружу, ломалась бы на каждом переносе данных. Слаг едет в снимке и переживает его.
  slug      String    @unique
  division  String // «Division 1» — зеркало divisionId, см. Division
  stage     String    @default("group") // group | playoff (src/lib/stages.ts)
  group     String? // «A» | «B» — только у групповой стадии
  bracket   String? // плей-офф: upper | lower | grand — по нему режут архив и статистику
  round     String? // плей-офф: подпись раунда сетки («Четвертьфинал», «Гранд-финал»)
  /// Позиция в сетке плей-офф — ключ слота из src/lib/playoff-bracket.ts («ub-qf1», «gf»).
  /// Он связывает серию с местом в сетке: страница плей-офф раскладывает серии по слотам, а из
  /// исходов вычисляет участников поздних слотов. У групповых серий пусто.
  slot      String?
  playedAt  DateTime?
  startAt   DateTime? // запланированное время начала серии — кормит анонс (привязка «Серия → время»)
  format    String? // bo1 | bo3 | bo5 — кормит анонс (привязка «Серия → формат»)
  homeScore Int
  awayScore Int
  guessed   Boolean   @default(true)

  /// Дивизион турнира. Строка `division` осталась зеркалом: по ней фильтруют полтора десятка
  /// выборок. Nullable — у серий, заведённых до появления турниров, пока может быть пусто.
  divisionRef Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  divisionId  Int?

  home   Team @relation("SeriesHome", fields: [homeId], references: [id], onDelete: Cascade)
  homeId Int
  away   Team @relation("SeriesAway", fields: [awayId], references: [id], onDelete: Cascade)
  awayId Int

  games   Match[]
  designs Design[]
  notices  SeriesNotice[]
  requests MatchRequest[]

  @@unique([division, stage, group, homeId, awayId])
  /// Один слот сетки — одна серия. У групповых slot=NULL, а NULL в sqlite-уникальности различны,
  /// поэтому групповую стадию это не ограничивает.
  @@unique([division, slot])
}

// Сохранённая генерация графики: id шаблона + payload формы (JSON строкой, sqlite).
// Нужна, чтобы переоткрыть прошлый анонс и поправить, а не собирать заново.
model Render {
  id         Int      @id @default(autoincrement())
  templateId String
  title      String?
  payload    String // JSON
  createdAt  DateTime @default(now())

  match   Match? @relation(fields: [matchId], references: [id])
  matchId Int?
}

/// Документ визуального редактора студии (canvas-конструктор). В отличие от Render (payload формы
/// под фиксированный кодовый шаблон) — это свободная раскладка: массив элементов с координатами.
/// Всё состояние в doc JSON-строкой (sqlite), тип — DesignDoc в src/studio/editor/model.ts.
/// Экспорт PNG клиентский (modern-screenshot), в БД хранится документ, а не картинка — переоткрыть и править.
model Design {
  id        Int      @id @default(autoincrement())
  title     String?
  doc       String // DesignDoc в JSON
  /// Тип графики серии: announce | score | result. Пустой seriesId = мастер-шаблон этого типа,
  /// заполненный seriesId = готовая графика конкретной серии (клон мастера с подставленными данными).
  kind      String?
  series    Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId  Int?
  /// Только для kind=score: номер карты, после которой сделан снимок счёта. Счёт накопительный —
  /// после карты 2 это 1:1, а не только текущий тотал. Позволяет держать графику счёта по каждой карте.
  mapNumber Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Материал медиатеки редактора: загруженная картинка (надпись, фон, декор) для расстановки на холст.
/// Файл лежит локально в public/uploads/library — modern-screenshot инлайнит только локальные картинки.
/// Отдельно от ростера (лого/фото команд): это самостоятельная библиотека графики, а не данные лиги.
model MediaAsset {
  id        Int      @id @default(autoincrement())
  name      String
  url       String // /uploads/library/<file>
  category  String   @default("material") // фаза 1: одна категория; далее — категории/теги
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
}

/// Сессия шоу-драфта UNDERBEER 2.0. Оператор на эфире собирает команды из живого ростера:
/// капитаны по очереди берут игроков, у каждой команды по разу есть «закрепить» и «украсть».
/// Это НЕ ростер лиги (RosterSpot) — эфемерный вывод оператора, как Render: всё состояние
/// лежит в payload JSON-строкой (sqlite), связей по FK с Player нет намеренно. В payload — только
/// id игроков; их карточки (ник/фото/mmr) резолвятся из ростера при чтении (src/lib/draft-data.ts),
/// ушедший из ростера игрок из состава просто выпадает — драфт живёт один эфир, это допустимо.
model DraftSession {
  id        Int      @id @default(autoincrement())
  title     String?
  status    String   @default("draft") // draft | done
  payload   String // JSON всего состояния драфта (src/lib/draft.ts → DraftState)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Сессия fearless-драфта: серия драфтов героев без повторов. Как DraftSession (UNDERBEER) —
/// эфемерный операторский вывод, всё состояние в payload JSON-строкой (src/lib/fearless.ts →
/// FearlessState). В снимок БД НЕ входит (как и DraftSession): это не данные лиги, а рабочий стол.
model FearlessSession {
  id        Int      @id @default(autoincrement())
  title     String?
  status    String   @default("draft") // draft | done
  payload   String // JSON всего состояния (src/lib/fearless.ts → FearlessState)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Стата игрока на карте — строки, из которых считаются все рейтинги турнира (src/lib/leaders.ts).
/// Пишется при привязке карты к серии (src/lib/match-sync.ts) из того же отчёта, что рисует постгейм.
/// `won` дублирует «команда игрока = победитель»: сторона игрока в самой строке не хранится,
/// а join через Match ради одного булева в каждом рейтинге не окупается.
/// Поля с пометкой «парс» есть только у распарсенных матчей, иначе остаются нулями.
model MatchStat {
  id           Int     @id @default(autoincrement())
  match        Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId      Int
  player       Player  @relation(fields: [playerId], references: [id])
  playerId     Int
  heroSlug     String  @default("") // ключ константы героя (== имя ассета), см. src/lib/assets.ts
  level        Int     @default(0)
  won          Boolean @default(false)
  heroDamage   Int     @default(0)
  heroHealing  Int     @default(0)
  towerDamage  Int     @default(0)
  netWorth     Int     @default(0)
  gpm          Int     @default(0)
  xpm          Int     @default(0)
  kills        Int     @default(0)
  deaths       Int     @default(0)
  assists      Int     @default(0)
  campsStacked Int     @default(0) // парс
  obsPlaced    Int     @default(0) // парс
  senPlaced    Int     @default(0) // парс
  lastHits     Int     @default(0)
  denies       Int     @default(0)

  @@unique([matchId, playerId])
}

// Расстановка вардов карты — из распарсенного отчёта OpenDota (obs_log/sen_log), пишется в syncMatch.
// Живёт в БД, чтобы «карта вардов команды» строилась по архиву офлайн, не ходя каждый раз в OpenDota.
// Строки производные: при перечитке карты сносятся и создаются заново (как MatchStat).
model Ward {
  id         Int    @id @default(autoincrement())
  match      Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId    Int
  // Команда лиги, поставившая вард. Денормализация из side + Match.radiantTeamId — чтобы
  // «все варды команды» брались одним where по teamId. null, если сторону не распознали.
  team       Team?  @relation(fields: [teamId], references: [id])
  teamId     Int?
  side       String // radiant | dire — для раскраски обеих сторон на одной карте
  type       String // obs | sen — обсервер / сентри
  heroSlug   String @default("") // кто поставил (ключ константы == имя ассета)
  x          Float // 0..1 доля карты слева направо
  y          Float // 0..1 доля карты сверху вниз
  placed     Int // секунда постановки (может быть < 0 — префейз)
  leftAt     Int? // секунда снятия/истечения; null — дожил до конца матча
  killerSlug String @default("") // герой, снявший вард раньше срока (иначе пусто)

  @@index([teamId])
  @@index([matchId])
}

// Реестр баллов — единственный способ менять очки. Корректировки = новые записи (аудит).
model PointsEntry {
  id          Int      @id @default(autoincrement())
  subjectType String // team | player | caster | streamer
  subjectId   Int // Team.id / Player.id / (позже) staff id
  reason      String // placement | mvp | cast | stream | manual
  amount      Int
  note        String?
  createdBy   String?
  createdAt   DateTime @default(now())

  match   Match? @relation(fields: [matchId], references: [id])
  matchId Int?
  /// За какой турнир начислено. Появилось вместе с турнирами: зачёт TP сезонный, и без этого поля
  /// новый сезон продолжал бы копить в ту же цифру. NULL — начисление вне турнира.
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  tournamentId Int?

}

/// Диалог телеграм-бота: где капитан остановился в квизе заявки. Живёт в БД, а не в памяти
/// процесса, потому что бот ходит за апдейтами long polling'ом с ноутбука оператора — процесс
/// перезапускают, а капитан к этому моменту продиктовал полсостава. Одна строка на чат;
/// заполненный квиз уезжает в `TeamApplication` (source = telegram) и строка обнуляется.
model BotSession {
  id        Int      @id @default(autoincrement())
  chatId    String   @unique // id чата в Telegram, строкой: числа там выходят за 2^53
  step      String // шаг квиза (src/lib/tg-quiz.ts → Step) либо `flow` — диалог ведёт граф
  /// Всё собранное на текущий момент, JSON (src/lib/tg-quiz.ts → State).
  state     String
  /// В каком флоу стоит диалог: `BotFlow.key` (main, invite, answer — src/lib/bot-flow/default-flow.ts).
  /// NULL — строка от диалога до Э7, когда флоу был единственный: читается как `main`.
  flowKey   String?
  /// На какой ноде графа стоит диалог (src/lib/bot-flow). NULL — граф этот чат не ведёт.
  flowNode  String?
  /// Версия графа, на которой диалог начался: `BotFlow.id`. Публикация новой версии не должна
  /// выбрасывать человека из середины анкеты, поэтому сессия доигрывает на своей.
  /// NULL при непустом `flowNode` — граф из сида в коде (BotFlow ещё ни разу не правили).
  flowVersion Int?
  /// Переменные, собранные графом: JSON `{ "ник": "…" }` (область `vars.*`).
  flowVars  String?
  updatedAt DateTime @updatedAt
}

/// Версия графа диалога телеграм-бота (src/lib/bot-flow). Граф описывает **навигацию**: что бот
/// говорит, какие кнопки показывает и куда ведёт каждая из них; тяжёлое (регистрация, заказ
/// встречи, выдача кода входа) остаётся в TS и подключается нодами-действиями.
///
/// **Документом, а не таблицами нод и рёбер.** Канвас правится целиком — каждое перетаскивание
/// ноды превращалось бы в пачку апдейтов, а откат к прошлому виду собирался бы по кускам. Здесь же
/// версия — одна строка, откат — выбор строки.
///
/// Порядок тот же, что у `BotSetting`: **дефолтный граф живёт сидом в коде**
/// (`src/lib/bot-flow/default-flow.ts`), в таблице лежат правки оператора. Пустая база = бот с
/// обычным флоу, а не бот без флоу.
///
/// `status`: draft (черновик редактора, не больше одного на `key`) | published (то, что в эфире,
/// тоже не больше одного) | archived (бывшая живая). Версии **не удаляются**: на них доигрывают
/// начатые диалоги (`BotSession.flowVersion`), и откат — это возврат к существующей строке.
model BotFlow {
  id        Int      @id @default(autoincrement())
  /// Какой флоу: main (меню), invite (онбординг по ссылке), answer (ответ сопернику) — плюс
  /// заведённые оператором. Как в него попадают, объявлено в самом графе (`entry`), а не здесь.
  key       String
  version   Int // номер версии внутри `key`, растёт монотонно
  status    String // draft | published | archived
  /// Граф целиком, JSON (src/lib/bot-flow/types.ts → BotFlowGraph).
  graph     String
  /// Подпись версии оператором: по чему её узнать в списке откатов.
  note      String?
  /// Когда версия ушла в эфир. NULL у черновика; у архивной остаётся — по ней виден порядок.
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, version])
}

/// Настройка флоу бота, изменённая оператором на /admin/bot: за сколько напоминать о встрече, какие
/// времена предлагать, тексты уведомлений. Здесь лежат **только отличия**:
/// дефолты живут в коде (src/lib/bot-settings.ts), иначе сброшенная база означала бы бота без
/// таймингов. Значение хранится строкой ровно в том виде, в каком его правит оператор
/// (`24h,1h`, `18:00,19:00`, текст уведомления) — разбор при чтении.
model BotSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique // ключ настройки (remind_before, slots, text_remind, … — src/lib/bot-settings.ts)
  value String
}

/// След уже отправленного уведомления о встрече — единственная защита от повтора. Бот живёт
/// долгоживущим процессом, который перезапускают с ноутбука: без отметки каждый запуск слал бы
/// напоминание заново, а перенос — по второму разу.
///
/// Ключ — тройка «серия + повод + метка». Метка разводит поводы одного вида: у `remind` это
/// интервал в минутах (`1440`, `60`) — за сутки и за час это два разных напоминания; у `moved` и
/// `scheduled` — новое время ISO, поэтому следующий перенос той же встречи разошлётся, а
/// повторная отправка того же — нет; у `no_time` — дата дайджеста (`2026-08-28`).
///
/// Связь с серией настоящая (в отличие от прочих следов бота): снесли встречу — следам о ней
/// делать нечего. Цена — `db:import` пересоздаёт серии и уносит следы с собой; после переноса
/// данных ближайшее напоминание может уйти вторично, и это дешевле, чем следы, указывающие на
/// чужую встречу с тем же id.
model SeriesNotice {
  id       Int      @id @default(autoincrement())
  kind     String // remind | moved | scheduled | no_time (src/lib/tg-schedule.ts)
  mark     String // что именно отправлено: интервал напоминания, новое время или дата дайджеста
  sentAt   DateTime @default(now())

  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId Int

  @@unique([seriesId, kind, mark])
}

/// Предложение времени встречи, отправленное капитаном из бота (`src/lib/match-request.ts`).
/// Живёт цепочкой: предложил один капитан → второй принял или предложил своё → организатор
/// подтвердил. Только последний шаг пишет время в `Series.startAt`: до апрува это переписка, а не
/// расписание (то же правило, что у заявки команды и правки профиля — бот сам ничего не публикует).
///
/// `status`: pending_opponent (ждём капитана соперника) | pending_admin (соперник принял, ждём
/// организатора) | approved | declined | expired. `expired` ставит тик расписания тем, чьё
/// предложенное время уже прошло: отвечать на «сыграем вчера в 20:00» некому и незачем.
///
/// `parentId` — встречное предложение: «предложить другое время» не правит чужую строку, а заводит
/// свою со ссылкой на исходную. Так в истории видно, кто с чего начал и чем кончилось, а исходное
/// предложение остаётся `declined`, а не подменяется задним числом.
///
/// Команда-отправитель здесь не хранится: она выводится из места капитана в составе дивизиона
/// встречи (`RosterSpot`). Отдельное поле разъехалось бы с составом при пересборке ростера.
model MatchRequest {
  id                Int       @id @default(autoincrement())
  proposedStartAt   DateTime
  status            String    @default("pending_opponent")
  opponentDecidedAt DateTime? // когда ответил капитан соперника
  adminDecidedAt    DateTime? // когда решил организатор
  declineReason     String? // причина отказа — её видят оба капитана
  createdAt         DateTime  @default(now())

  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId Int
  /// Кто предложил — капитан, а не аккаунт: в составе стоит игрок, и «чья это команда» читается
  /// именно из его места (`RosterSpot`).
  proposedBy         Player @relation(fields: [proposedByPlayerId], references: [id], onDelete: Cascade)
  proposedByPlayerId Int

  parent   MatchRequest?  @relation("MatchRequestChain", fields: [parentId], references: [id], onDelete: SetNull)
  parentId Int?
  counters MatchRequest[] @relation("MatchRequestChain")

  @@index([seriesId])
  @@index([status])
}

/// Чат, который писал боту: chat_id ↔ телеграм-хендл. Нужен для исходящих сообщений — Telegram
/// не даёт написать человеку по хендлу, только по chat_id, а он появляется лишь когда человек
/// сам написал боту. Поэтому запоминаем всех, кто хоть раз написал: иначе уведомить о решении по
/// заявке некого. Ничего личного здесь нет — id чата и публичный хендл.
model TgChat {
  id       Int      @id @default(autoincrement())
  chatId   String   @unique
  username String? // без «@», как Player.telegram; у человека без хендла пусто
  /// Аккаунт, за которым закреплён чат (после регистрации в боте). Без relation — как остальные
  /// следы в этой базе: id на машинах разные, а связь здесь нужна только чтобы знать, куда писать.
  accountId Int?
  seenAt   DateTime @updatedAt
}

/// Одноразовый код входа на сайт, выданный ботом (`src/lib/tg-login.ts`). У пришедшего из телеграма
/// нет ни почты, ни пароля — войти ему нечем, а Telegram Login Widget требует домен, привязанный в
/// BotFather, которого до выката наружу нет. Код живёт 10 минут и сгорает при первом использовании;
/// на аккаунт держим один живой — так подбор шестизначного числа упирается в одну цель, а не в
/// «любой из выданных».
model TgLoginCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique // 6 цифр, как одноразовый пароль
  /// Аккаунт, которому выдан код. Без relation — как остальные следы бота в этой базе.
  accountId Int
  expiresAt DateTime
  usedAt    DateTime? // непусто = код уже потрачен, второй раз не пустит
  createdAt DateTime  @default(now())
}


/// «Эти двое — разные люди»: решение оператора по паре похожих профилей (`/admin/roster/duplicates`).
/// Хранится только отказ: слияние убирает одну запись физически, и пара больше не всплывёт сама.
/// Без этой таблицы очередь дублей вечно показывала бы одних и тех же тёзок.
model PlayerDistinct {
  id          Int      @id @default(autoincrement())
  /// Меньший и больший id пары — порядок нормализован, чтобы (a,b) и (b,a) были одной строкой.
  aId         Int
  bId         Int
  decidedAt   DateTime @default(now())
  decidedById Int? // след в истории, без relation — как TeamApplication.reviewedById

  @@unique([aId, bId])
}


/// Анкета под ивент: набор произвольных вопросов, который бот задаёт в телеграме. Отдельно от
/// заявки команды (`TeamApplication`) сознательно: заявка завязана на модель ростера — команда,
/// позиции, ссылки на профили, — а анкета собирает что угодно (запись на шоуматч, опрос, заявка
/// кастера) и никуда, кроме своих ответов, не пишет. Общий у них только движок «вопрос → ответ →
/// сводка», а правила проверки и последствия разные.
model Quiz {
  id          Int      @id @default(autoincrement())
  slug        String   @unique // в адресе админки
  title       String // подпись кнопки в боте
  description String? // что это и зачем — показывается перед первым вопросом
  /// draft (не видно никому) | open (бот предлагает) | closed (приём закрыт, ответы остались)
  status      String   @default("draft")
  closeAt     DateTime? // срок приёма; пусто — до ручного закрытия
  createdAt   DateTime @default(now())

  questions QuizQuestion[]
  responses QuizResponse[]
}

/// Вопрос анкеты — из тех, что оператор заводит на /admin/quizzes. Существует только в базе:
/// дефолта у него нет и придумать его не из чего (в отличие от графа диалога, у которого сид в коде).
model QuizQuestion {
  id       Int     @id @default(autoincrement())
  text     String
  /// Варианты ответа кнопками, по строке на вариант. Пусто — отвечают свободным текстом.
  options  String?
  required Boolean @default(true)
  orderNo  Int     @default(0)

  quiz   Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId Int

  @@index([quizId])
}

/// Заполненная анкета. Ответы лежат JSON'ом вместе с текстом вопроса — как в заявке бота: вопрос
/// потом перепишут, а ответ прошлого месяца должен остаться читаемым.
model QuizResponse {
  id        Int      @id @default(autoincrement())
  /// Чат, из которого пришли ответы, и хендл на момент заполнения — иначе с человеком не связаться.
  chatId    String
  username  String?
  /// Игрок лиги, если опознан (src/lib/tg-menu.ts). Без relation: это след, а не связь — профиль
  /// могут слить или удалить, а ответ должен пережить.
  playerId  Int?
  answers   String
  createdAt DateTime @default(now())

  quiz   Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId Int

  @@index([quizId])
}

/// Правка своего профиля, присланная игроком из бота (src/lib/profile-edit.ts). Отдельная очередь,
/// а не прямая запись в `Player`: бот сам ничего не публикует — всё, что пишет, проходит оператора
/// (решение второй волны бота, ../../DECISIONS.md 27.08.2026). На сайте вошедший игрок правит те же
/// поля сразу (`updateOwnProfile`) — там его личность подтверждена сессией, а здесь ключом служит
/// привязка `UserAccount.tgId`, и MMR с фото лига всё равно проверяет глазами.
///
/// Одна строка — одно поле: человек чаще правит что-то одно, а оператору так видно, что именно
/// меняется, без диффа всей анкеты. Старое значение снимается на момент отправки — чтобы в очереди
/// было видно «из чего во что», даже если профиль успели поправить с другой стороны.
model ProfileEditRequest {
  id       Int    @id @default(autoincrement())
  /// Какое поле правим: nickname | city | mmr | dotabuffUrl | stratzUrl | steamUrl | photo
  /// (канон — EDIT_FIELDS в src/lib/profile-edit.ts).
  field    String
  oldValue String?
  newValue String
  status   String @default("pending") // pending | approved | rejected
  notes    String? // причина возврата — её видит приславший
  /// Чат, из которого пришла правка: по нему уйдёт решение организатора. Как и у заявки команды,
  /// это единственная надёжная ниточка к человеку.
  chatId   String?
  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById Int? // след в истории, без relation — как UserAccount.reviewedById

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId Int

  @@index([playerId])
}

/// Личная переписка двух игроков лиги. Модель заведена парой «беседа + участник», хотя диалог
/// сейчас ровно на двоих: комната как отдельная сущность позволяет добавить чат команды или
/// общий канал, не переписывая ни хранение, ни доставку (там меняется только состав участников).
///
/// `key` — «меньший id : больший id» аккаунтов, уникально. Так «найти или создать беседу с этим
/// человеком» решается одним upsert без гонки: без ключа два одновременных сообщения завели бы
/// две беседы на одну пару.
model Conversation {
  id            Int      @id @default(autoincrement())
  key           String   @unique // "12:37" — пара id аккаунтов по возрастанию
  createdAt     DateTime @default(now())
  /// Время последнего сообщения — по нему сортируется список бесед. Отдельным полем, а не
  /// подзапросом max(createdAt): список читается на каждый рендер шапки, а пишется редко.
  lastMessageAt DateTime @default(now())

  members  ConversationMember[]
  messages ChatMessage[]
}

/// Участие аккаунта в беседе. Здесь же отметка о прочтении — она у каждого своя.
model ConversationMember {
  id             Int          @id @default(autoincrement())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId Int
  account        UserAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId      Int
  /// До какого момента человек прочитал беседу. null — не открывал ни разу.
  lastReadAt     DateTime?

  @@unique([conversationId, accountId])
  @@index([accountId])
}

/// Сообщение. Правки и удаления не предусмотрены намеренно: переписка — это след разговора,
/// а не документ; оператору для разбора жалобы нужна история как она была.
model ChatMessage {
  id             Int          @id @default(autoincrement())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId Int
  sender         UserAccount  @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId       Int
  text           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, id]) // лента беседы и «что нового после id N» — оба по этому индексу
}
