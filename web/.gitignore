# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Кэш собранных отчётов по матчам (lib/match-cache.ts) — вывод, а не ассет релиза.
# Удаляется без последствий: приложение просто сходит в OpenDota заново.
/.cache/

# Лист контрольных кадров (scripts/screen-sheet.ts) — вывод для разбора вёрстки, а не ассет:
# пересобирается одной командой, весит мегабайты и наружу по HTTP не раздаётся (не в public/).
/.sheets/

# production
/build

# Статическая таблица для заливки на хостинг — артефакт сборки, пересобирается скриптом
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# кроме шаблона без значений — с него начинается настройка новой машины
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Лого команд и фото ростера коммитим: без них релизная сборка выходит пустой.
# Генерации OpenAI — черновики по мегабайту, в репозитории им делать нечего.
/public/uploads/generated/
# Архив выгруженных постгеймов — тоже вывод, а не ассет релиза: по два PNG 1920×1080
# на матч, за сезон это сотни мегабайт в истории, откуда их уже не вычистить.
/public/uploads/postgame/
# Медиатека редактора — брендовый декор шаблонов (надписи, фоны, VS, дивизионы):
# коммитим как лого/фото ростера, иначе после git pull библиотека пустая, а
# MediaAsset в снапшоте БД ссылается на несуществующие файлы. См. §8 CLAUDE.md.

# local sqlite db
# Саму prisma/dev.db коммитим: данные лиги (сетка встреч, правки результатов) вводятся руками
# в UI и скриптами из таблицы не восстанавливаются — без файла новая машина стартует пустой.
# Цена: бинарник в истории и мерж невозможен, поэтому правим базу на одной машине за раз.
/dev.db
/dev.db-journal
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm

# prisma-generated agent skill scaffolding (tooling, не исходники проекта)
/.agents/
/.windsurf/
/.claude/skills/
/skills-lock.json
